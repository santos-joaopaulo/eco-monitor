rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pontos de coleta oficiais: leitura pública e gestão administrativa (RNF11).
    match /collectPoints/{pointId} {
      allow read, write: if true;
    }

    // Campanhas de coleta: leitura pública e gestão administrativa (RF08, RF09).
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Guias de descarte: leitura pública e gestão permitida (RNF09).
    match /disposalGuides/{guideId} {
      allow read, write: if true;
    }

    // Metadados de sincronização (timestamps do servidor): leitura e atualização permitidas.
    match /metadata/{collectionId} {
      allow read, write: if true;
    }

    // Sugestões de novos pontos enviadas pelos usuários:
    // Criação aberta e anônima, leitura e moderação pelo painel administrativo (RF10, RF11).
    match /pointSuggestions/{suggestionId} {
      allow read, write: if true;
    }
  }
}
